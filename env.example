# Copia este archivo a ".env" y ajusta los valores reales -- NUNCA subas el .env real a GitHub.

DATABASE_URL=postgresql://red:cambia_esta_clave@localhost:5432/red_encuestas
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
JWT_EXPIRA_HORAS=12

# Radio por default de la geocerca de sección, en metros (ver reglas anti-simulación acordadas).
GEOCERCA_RADIO_M=200
GEOCERCA_RADIO_ALTA_PRIORIDAD_M=1000

# Duración mínima de una encuesta "completa" antes de marcarla sospechosa, en segundos.
DURACION_MINIMA_ALERTA_SEG=120
DURACION_MINIMA_ALTA_PRIORIDAD_SEG=45

# Hueco de inactividad entre encuestas del mismo brigadista antes de marcar alerta, en minutos.
HUECO_INACTIVIDAD_MIN=45

# Carpeta local donde se guardan audios y fotos MIENTRAS no haya un bucket tipo S3 conectado.
STORAGE_DIR=./storage

# Orígenes permitidos para que la app (PWA en Vercel) pueda llamar a esta API.
CORS_ORIGINS=http://localhost:5173,https://TU-APP.vercel.app
